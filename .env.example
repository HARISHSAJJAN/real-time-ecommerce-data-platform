# ==============================================================================
# Real-Time E-Commerce Data Platform - Environment Configuration
# Copy this file to `.env` and adjust values as needed.
# Never commit the real `.env` file.
# ==============================================================================

# ---------- Kafka ----------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_BOOTSTRAP_SERVERS_HOST=localhost:29092
KAFKA_TOPIC_EVENTS=ecommerce-events
KAFKA_TOPIC_DLQ=ecommerce-dead-letter
KAFKA_CONSUMER_GROUP=spark-streaming-consumer
KAFKA_TOPIC_PARTITIONS=6
KAFKA_TOPIC_REPLICATION_FACTOR=1

# ---------- Data Generator ----------
EVENTS_PER_SECOND=20
NUM_USERS=1000
NUM_PRODUCTS=200
MALFORMED_EVENT_RATE=0.02
DUPLICATE_EVENT_RATE=0.03
RANDOM_SEED=42

# ---------- StarRocks ----------
STARROCKS_HOST=starrocks
STARROCKS_PORT=9030
STARROCKS_HTTP_PORT=8030
STARROCKS_DATABASE=ecommerce
STARROCKS_USER=root
STARROCKS_PASSWORD=

# ---------- Trino ----------
TRINO_HOST=trino
TRINO_PORT=8080
TRINO_USER=trino
TRINO_CATALOG=starrocks
TRINO_SCHEMA=ecommerce

# ---------- PostgreSQL (metadata) ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=platform_metadata
POSTGRES_USER=platform_admin
POSTGRES_PASSWORD=change_me_in_dot_env

# ---------- Spark ----------
SPARK_APP_NAME=ecommerce-streaming-pipeline
SPARK_MASTER=local[*]
SPARK_SHUFFLE_PARTITIONS=8
SPARK_TRIGGER_INTERVAL=10 seconds
SPARK_WATERMARK_DELAY=2 minutes
SPARK_WINDOW_DURATION=1 minute
SPARK_CHECKPOINT_DIR=/opt/spark-checkpoints

# ---------- FastAPI ----------
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=INFO
API_CORS_ORIGINS=http://localhost:8501

# ---------- Streamlit ----------
STREAMLIT_API_BASE_URL=http://api:8000
DASHBOARD_REFRESH_SECONDS=15
